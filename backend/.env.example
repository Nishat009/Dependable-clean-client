MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net
DB_NAME=houseCleaning
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
# Signs sign-in tokens. Required in production: the API refuses to start if it is empty, shorter than 32 characters
# or still an example value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Demo sign-in (admin, staff and customer buttons). On by default in development, off by default in production.
# Set to on only for a public demo deployment with no real customer data. Demo accounts get a new random password
# on every start and open only through the demo buttons.
# DEMO_ACCOUNTS=off
# Sign-in, sign-up and setup attempts allowed per IP address and email in each 15 minutes.
# AUTH_RATE_LIMIT=20
# Proxies in front of the API (1 on Render and most hosts, the default in production), so rate limits see the real client IP.
# TRUST_PROXY=1
# Set this if the API cannot reach MongoDB because of local DNS (querySrv ECONNREFUSED).
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Business configuration (the frontend reads these from the API).
BUSINESS_TIMEZONE=Asia/Dhaka
BUSINESS_CURRENCY=BDT
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Used only by npm run setup-owner; no password is kept in this file.
OWNER_EMAIL=
OWNER_NAME=
